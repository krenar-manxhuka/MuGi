# ─── LLM Provider ────────────────────────────────────────────────────────────
#
# Selects the LLM backend.
# Valid values: mock | anthropic | openai | ollama
# Default: mock  (no API key needed, deterministic responses for development)
#
LLM_PROVIDER=mock

# Model override. Each provider has a sensible built-in default.
# anthropic default: claude-sonnet-4-6
# openai default:    gpt-4o
# ollama default:    llama3
#
# LLM_MODEL=claude-opus-4-7


# ─── Anthropic ────────────────────────────────────────────────────────────────
# Required when LLM_PROVIDER=anthropic
#
# ANTHROPIC_API_KEY=sk-ant-...


# ─── OpenAI / OpenAI-compatible ──────────────────────────────────────────────
# Required when LLM_PROVIDER=openai
#
# OPENAI_API_KEY=sk-...
#
# Override the base URL to point at any OpenAI-compatible API:
#   Groq:        https://api.groq.com/openai/v1
#   Together AI: https://api.together.xyz/v1
#   Mistral:     https://api.mistral.ai/v1
#   LM Studio:   http://localhost:1234/v1
#   vLLM:        http://localhost:8000/v1
#
# OPENAI_BASE_URL=https://api.openai.com/v1


# ─── Ollama (local open-source models) ───────────────────────────────────────
# Used when LLM_PROVIDER=ollama
#
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3


# ─── Workflow ─────────────────────────────────────────────────────────────────

# Maximum number of coder → reviewer → revise cycles before accepting output.
MAX_REVISIONS=3

# Directory where the final artifact files are written.
OUTPUT_DIR=output

# Directory checked for prompt template overrides (*.tmpl files).
# Falls back to the embedded defaults when a file is not found here.
PROMPTS_DIR=prompts
